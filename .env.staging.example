# Staging: the production stack, on this machine, with a local certificate.
# Copy to .env.staging and set the three passwords to anything long.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.staging up -d --build
#   open https://localhost  (Caddy's local certificate; trust it once or click through)
#
# ENVIRONMENT=staging means the production refusals do not apply, which is
# what lets staging show the login code and run without an API key.

DOMAIN=localhost
ENVIRONMENT=staging

SECRET_KEY=staging-only-secret-key-that-is-long-enough-to-pass
POSTGRES_PASSWORD=staging-database-password
REDIS_PASSWORD=staging-redis-password

OTP_DEV_ECHO=true
# A demonstration: only the sample accounts sign in, the login page offers
# them, every page says so, and the data is reseeded every night.
DEMO_MODE=true
# No wait between codes for one number, so the browser tests can sign the
# same account in through the API and then the page. Production keeps 60.
OTP_RESEND_COOLDOWN_SECONDS=0
AI_OFFLINE=true
