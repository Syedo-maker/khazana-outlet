# Production settings for docker-compose.prod.yml. Copy to .env.production,
# fill in every value, and keep the copy out of git (it is ignored).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# The API refuses to start in production with any of the unsafe values the
# development defaults use; config.assert_production_ready lists them.

# The public host name. Caddy gets its certificate for it.
DOMAIN=khazana.example.pk

ENVIRONMENT=production

# Long random strings. For example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Off in production: codes go by SMS, never in the response or the log.
OTP_DEV_ECHO=false

# The AI layer, live.
AI_OFFLINE=false
ANTHROPIC_API_KEY=
AI_DAILY_SPEND_LIMIT_USD=25
AI_BRAND_MONTHLY_SPEND_LIMIT_USD=50

# The account buyers pay bank transfers into. Production refuses the sandbox value.
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_IBAN=

# Optional: error reports to Sentry or a self hosted GlitchTip.
SENTRY_DSN=

# Optional: API worker processes per container, and how long backups are kept.
API_WORKERS=3
BACKUP_KEEP_DAYS=14

# Optional: where release images come from, and which release.
# IMAGE_PREFIX=ghcr.io/syedo-maker/khazana
# VERSION=1.0.0
