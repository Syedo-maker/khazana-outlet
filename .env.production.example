# Production settings for docker-compose.prod.yml. Copy to .env.production,
# fill in every value, and keep the copy out of git (it is ignored).
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# The API refuses to start in production with any of the unsafe values the
# development defaults use; config.assert_production_ready lists them.
#
# These defaults are the zero budget pilot: no paid provider is needed for
# any of it. docs/oracle-free-tier.md walks through a free server.

# The public host name. Caddy gets its certificate for it. With no domain,
# use your server's IP with dashes and .sslip.io, for example
# 203-0-113-10.sslip.io (docs/oracle-free-tier.md, step 5).
DOMAIN=khazana.example.pk

ENVIRONMENT=production

# Long random strings. For example: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ---------- How people sign in ----------
# No SMS gateway in the pilot: an admin sends each person a single use link.
SMS_LOGIN_ENABLED=false
OTP_DEV_ECHO=false
INVITE_TTL_HOURS=72

# ---------- How brands are paid ----------
# direct: the buyer pays the brand's own courier in cash on delivery, and the
# platform invoices its commission monthly. The platform never holds money.
DEFAULT_SETTLEMENT_MODE=direct
# Only needed with DEFAULT_SETTLEMENT_MODE=platform: the account buyers pay
# bank transfers into. Production refuses the sandbox value then.
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_IBAN=

# ---------- AI ----------
# One dollar a day; when it is spent, every AI feature works by hand until
# tomorrow. With no key, set AI_ENABLED=false and leave the key empty.
AI_ENABLED=true
AI_OFFLINE=false
ANTHROPIC_API_KEY=
AI_DAILY_SPEND_LIMIT_USD=1
AI_BRAND_MONTHLY_SPEND_LIMIT_USD=50

# ---------- Paid providers, all off for the pilot ----------
WHATSAPP_ENABLED=false
SPEECH_TO_TEXT_ENABLED=false
VISUAL_SEARCH_ENABLED=false

# ---------- Alerts by email ----------
# Plain email to one address. Gmail works free with an app password:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME and ALERT_EMAIL_FROM
# your Gmail address, SMTP_PASSWORD the 16 character app password. See
# docs/deployment.md, "Alerts by email". Empty: alerts go to the log only.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Optional: error reports to Sentry or a self hosted GlitchTip.
SENTRY_DSN=

# Optional: API worker processes (one per CPU), and how long backups are kept.
API_WORKERS=2
BACKUP_KEEP_DAYS=14

# Optional: where release images come from, and which release.
# IMAGE_PREFIX=ghcr.io/syedo-maker/khazana
# VERSION=1.0.0
