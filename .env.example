# Copy to .env and fill in. Never commit .env.

# ---------- Core ----------
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# ---------- Database ----------
# Postgres for development and production.
DATABASE_URL=postgresql+psycopg://khazana:khazana@localhost:5432/khazana
# Tests use their own throwaway SQLite file, no configuration needed.

# ---------- Redis, for the job queue and the OTP store ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Auth ----------
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# In development, leave this true to print the OTP to the log instead of
# sending an SMS. Must be false in production.
OTP_DEV_ECHO=true

# ---------- SMS and WhatsApp, left blank until Phase 6 ----------
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_TOKEN=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
# Model routing defaults. See docs/ai-architecture.md section 4.
AI_MODEL_DEFAULT=claude-opus-5-5
AI_MODEL_BULK=claude-haiku-4-5
# Hard spend guards, in US dollars.
AI_DAILY_SPEND_LIMIT_USD=5.00
AI_BRAND_MONTHLY_SPEND_LIMIT_USD=20.00
# Set to true to run every AI feature against recorded fixtures instead of
# the live API. Development and CI default.
AI_OFFLINE=true

# ---------- Object storage for photographs ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Embeddings, self hosted, see docs/ai-architecture.md ----------
EMBEDDING_MODEL=siglip-base-patch16-224
EMBEDDING_DIM=768
EMBEDDING_SERVICE_URL=
